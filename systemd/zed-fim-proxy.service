[Unit]
Description=Zed Edit Predictions Local PHP Syntax Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/php -S 127.0.0.1:8089 -t %h/zed-gemini-predict/public %h/zed-gemini-predict/public/index.php
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
